{
  "name": "hangs-free",
  "main": "expo-router/entry",
  "version": "0.3.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --config jest.config.js --watchAll",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "ts-check": "tsc-files --noEmit",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "release": "echo 'Releases are automated via Release Please. Push to main branch with conventional commits to trigger a release.'"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npm run ts-check"
    ],
    "*.{js,jsx,ts,tsx}": [
      "npm run lint:fix"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "expo": "55.0.14",
    "expo-blur": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.13",
    "expo-dev-client": "55.0.27",
    "expo-device": "~55.0.14",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-linking": "~55.0.12",
    "expo-router": "~55.0.12",
    "expo-splash-screen": "~55.0.17",
    "expo-status-bar": "~55.0.5",
    "expo-symbols": "~55.0.7",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-ble-plx": "3.4.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-graph": "1.1.0",
    "react-native-mmkv": "3.3.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@babel/core": "7.26.8",
    "@commitlint/cli": "19.7.1",
    "@commitlint/config-conventional": "19.7.1",
    "@testing-library/react-native": "13.2.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "8.57.1",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-testing-library": "7.1.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-expo": "55.0.15",
    "lint-staged": "15.4.3",
    "prettier": "3.4.2",
    "react-test-renderer": "19.2.0",
    "tsc-files": "1.1.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
